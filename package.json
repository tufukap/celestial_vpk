{
  "name": "celestial-vpk",
  "productName": "Celestial VPK",
  "version": "0.1.0-beta.1",
  "description": "Local Dota 2 mod projects, VPK builder and mod manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:preview": "node tools/workshop-preview.js",
    "test:projects-ui": "node tools/projects-smoke.js",
    "dist": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "test": "node --test \"test/**/*.test.js\"",
    "sandbox:seed": "node tools/sandbox.js seed",
    "sandbox:reset": "node tools/sandbox.js reset",
    "sandbox:status": "node tools/sandbox.js status",
    "start:sandbox": "electron . --user-data-dir=sandbox/userdata"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheFleece/dota2-mod-manager.git"
  },
  "author": "Mykhailo Lynnyk",
  "license": "GPL-3.0",
  "homepage": "https://github.com/TheFleece/dota2-mod-manager",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "local.tufukap.celestialvpk",
    "productName": "Celestial VPK",
    "icon": "build/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "preload-uninstall.js",
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "CHANGELOG.md",
      "CHANGELOG.ru.md",
      "LICENSE",
      "NOTICE"
    ],
    "protocols": [
      {
        "name": "Celestial VPK preset",
        "schemes": [
          "d2mm"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "d2mm",
        "name": "Celestial VPK preset",
        "role": "Editor",
        "mimeType": "application/x-d2mm"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Celestial-VPK-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Celestial-VPK-Portable-${version}.${ext}",
      "requestExecutionLevel": "user"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "artifactName": "Celestial-VPK-${version}.${ext}",
      "synopsis": "Create and manage local VPK mods for Dota 2"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Celestial VPK",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": null
  }
}
